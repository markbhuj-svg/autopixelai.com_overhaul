---
import '@fontsource-variable/instrument-sans/wght-italic.css';
import { bookingUrl, campaignUrl } from '../site';
---
<section class="hero" aria-labelledby="hero-title">
  <video class="hero-media" data-src="/media/hero.mp4" poster="/media/hero-poster.webp"
    width="1600" height="900" muted loop playsinline preload="none" aria-hidden="true"></video>

  <div class="hero-content wrap">
    <h1 id="hero-title">
      <span class="visually-hidden">AI Car Photography For Dealerships.</span>
      <span class="hero-phrase" data-hero-phrase data-active aria-hidden="true">
        <span><span class="hero-accent">AI Car Photography</span></span> <span>For Dealerships.</span>
      </span>
      <span class="hero-phrase" data-hero-phrase aria-hidden="true">
        <span>Turn <span class="hero-accent">Lot</span> Photos Into</span> <span><span class="hero-accent">Studio-Quality Images</span>.</span>
      </span>
      <span class="hero-phrase hero-phrase-long" data-hero-phrase aria-hidden="true">
        <span>Every Vehicle Deserves A</span> <span><span class="hero-accent">Showroom-Quality</span> Impression.</span>
      </span>
      <span class="hero-phrase hero-phrase-long" data-hero-phrase aria-hidden="true">
        <span>From Camera To Customer-Ready.</span> <span><span class="hero-accent">Faster Than Ever</span>.</span>
      </span>
      <span class="hero-phrase" data-hero-phrase aria-hidden="true">
        <span><span class="hero-accent">Better</span> Vehicle Photos.</span> <span>Straight To <span class="hero-accent">Your Website</span>.</span>
      </span>
    </h1>
    <p>Guided capture and AI showroom backgrounds for your inventory.</p>
    <div class="hero-actions">
      <a class="button hero-cta" href={bookingUrl}>Book a demo</a>
      <a class="button" href={`${campaignUrl}#offer-form`}>Get Black Friday Deal</a>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('video.hero-media');
  const heading = document.querySelector<HTMLElement>('#hero-title');
  const phrases = heading?.querySelectorAll<HTMLElement>('[data-hero-phrase]');
  if (heading && phrases?.length) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let rotation: number | undefined;
    const showHeadline = (nextIndex: number) => {
      const animate = !reducedMotion.matches;
      phrases.forEach((phrase, index) => {
        phrase.toggleAttribute('data-active', index === nextIndex);
        phrase.toggleAttribute('data-leaving', animate && index === activeIndex && index !== nextIndex);
      });
      activeIndex = nextIndex;
      heading.toggleAttribute('data-rotating', animate);
    };
    const applyPreference = () => {
      window.clearInterval(rotation);
      if (reducedMotion.matches) {
        showHeadline(0);
        video?.pause();
        delete document.body.dataset.homeMotion;
        return;
      }
      rotation = window.setInterval(() => {
        showHeadline((activeIndex + 1) % phrases.length);
      }, 4000);
      document.body.dataset.homeMotion = 'playing';
      if (video) {
        video.src ||= video.dataset.src!;
        void video.play().catch(() => { /* Keep the poster if autoplay is blocked. */ });
      }
    };

    reducedMotion.addEventListener('change', applyPreference);
    applyPreference();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: clip;
    background: var(--background);
    text-align: center;
  }

  .hero-media, .hero::before, .hero::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-media {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::before {
    content: "";
    z-index: -2;
    background:
      repeating-linear-gradient(90deg, #ffffff14 0 1px, transparent 1px 3.75rem),
      repeating-linear-gradient(0deg, #ffffff14 0 1px, transparent 1px 3.75rem);
  }

  .hero::after {
    content: "";
    z-index: -1;
    background:
      linear-gradient(180deg, var(--background), #0007 26%, #0006 50%, #0007 74%, var(--background)),
      radial-gradient(ellipse at 50% 55%, #000a, #0004 75%);
  }

  .hero-content {
    padding-block: clamp(8rem, 30svh - 3.5rem, 14rem) 0;
  }

  h1 {
    --headline-scale: 0.70;
    display: grid;
    font-family: var(--body);
    font-style: italic;
    font-weight: 790;
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-size: calc(clamp(3rem, 1rem + 6.4vw, 7.25rem) * var(--headline-scale));
    text-wrap: balance;
  }

  .hero-phrase {
    grid-area: 1 / 1;
    align-self: center;
    min-inline-size: 0;
    opacity: 0;
    visibility: hidden;
  }

  .hero-phrase > span { display: block; }
  .hero-phrase-long { font-size: min(0.75em, calc(5.45vw * var(--headline-scale))); }
  .hero-accent { color: var(--accent); }

  .hero-phrase[data-active] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-phrase[data-leaving] {
      opacity: 1;
      visibility: visible;
    }

    .hero-phrase[data-leaving] > span {
      animation: headline-exit 700ms cubic-bezier(0.16, 0.9, 0.25, 1) both;
    }

    h1[data-rotating] .hero-phrase[data-active] > span {
      animation: headline-enter 700ms cubic-bezier(0.16, 0.9, 0.25, 1) both;
    }

    h1[data-rotating] .hero-phrase > span + span {
      animation-delay: 200ms;
    }

    @keyframes headline-enter {
      from { opacity: 0; transform: translateX(80px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes headline-exit {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(-80px); }
    }
  }

  p {
    margin: 1.2rem auto 1.5rem;
    max-inline-size: 35ch;
    color: #efe1d2;
    font-size: clamp(0.95rem, 0.83rem + 0.4vw, 1.1rem);
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-actions .button {
    min-block-size: 3rem;
    padding-inline: 1.65rem;
    border-radius: 999px;
  }

  .hero-cta {
    border-color: #f2c9adad;
    color: var(--text);
    background: #171312bf;
  }

  .hero-cta:hover { background: var(--accent); color: var(--ink); }

  @media (max-width: 45rem) {
    h1 { font-size: calc(clamp(1.5rem, 8.4vw, 3.75rem) * var(--headline-scale)); }
    .hero-phrase-long { font-size: 0.82em; }
    .hero-content { padding-block: clamp(6.25rem, 20svh, 11.5rem) 0; }
    p { margin-block: 1rem 1.35rem; }
    .hero::after { background-color: #0002; }
  }

  @media (max-height: 38rem) {
    .hero-content { padding-block: 4.75rem 0; }
  }

  @media (max-height: 30rem) and (orientation: landscape) {
    .hero-content { padding-block: 2.85rem 0; }
    h1 { font-size: calc(clamp(2rem, 10dvh, 4rem) * var(--headline-scale)); }
    p { max-inline-size: none; margin-block: 0.5rem 0.65rem; }
  }
</style>
