---
import SiteLogo from './SiteLogo.astro';
import { bookingUrl, campaignUrl, signInUrl, siteLinks } from '../site';

const { currentPath } = Astro.props;
const navLinks = [...siteLinks, { href: campaignUrl, label: 'Black Friday' }];
---
<div class="site-header-slot">
  <header class="site-header">
    <div class="site-header-inner wrap">
      <SiteLogo />
      <nav class="desktop-nav" aria-label="Main navigation">
        {navLinks.map(({ href, label }) => <a class:list={{ 'header-offer': href === campaignUrl }} href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="sign-in" href={signInUrl}>Sign in</a>
        <a class="header-offer mobile-offer" href={campaignUrl} aria-current={currentPath === campaignUrl ? 'page' : undefined}>Black Friday</a>
        <a class="button button-outline header-book" href={bookingUrl} aria-current={currentPath === bookingUrl ? 'page' : undefined}>
          Book a demo <span class="header-book-icon" aria-hidden="true"><span class="arrow"></span></span>
        </a>
      </div>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {siteLinks.map(({ href, label }) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
          <a href={signInUrl}>Sign in</a>
          <a href={bookingUrl} aria-current={currentPath === bookingUrl ? 'page' : undefined}>Book a demo</a>
        </nav>
      </details>
    </div>
  </header>
</div>

<script>
  const slot = document.querySelector('.site-header-slot')!;
  const header = slot.querySelector('.site-header')!;
  const footer = document.querySelector('.site-footer')!;

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === slot) {
          header.toggleAttribute('data-floating', !entry.isIntersecting && entry.boundingClientRect.bottom <= 0);
        } else {
          header.toggleAttribute('data-near-footer', entry.isIntersecting);
        }
      }
    }, { rootMargin: '0px 0px 80px 0px' });
    observer.observe(slot);
    observer.observe(footer);
  }
</script>

<style>
  .site-header-slot { min-block-size: var(--header-height); }

  .site-header {
    position: relative;
    z-index: 2;
    background: var(--background);
  }

  .site-header-inner {
    position: relative;
    min-block-size: var(--header-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
  }

  nav, .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.6vw, 1.8rem);
    font-size: 0.875rem;
    font-weight: 550;
  }

  nav a, .sign-in { color: var(--muted); }

  nav a:hover, .sign-in:hover { color: var(--text); }

  a[aria-current="page"] { color: var(--text); text-decoration: underline; text-underline-offset: 0.4em; }

  .site-header .header-offer,
  .site-header[data-floating] .desktop-nav .header-offer {
    color: var(--accent);
    text-decoration: none;
  }

  .header-book {
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    border-color: #ffffff65;
    min-block-size: 2.4rem;
  }

  .header-book-icon, .mobile-nav, .mobile-offer { display: none; }

  @media (max-width: 65rem) {
    .desktop-nav, .sign-in { display: none; }
    .header-actions { margin-inline-start: auto; }
    .mobile-nav { display: block; }
    .mobile-offer {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding-inline: 0.35rem;
      white-space: nowrap;
    }

    .mobile-nav summary {
      min-block-size: 2.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      font-size: 0.875rem;
      cursor: pointer;
    }

    .mobile-nav summary::-webkit-details-marker { display: none; }

    .mobile-nav summary::after {
      content: "";
      inline-size: 0.45rem;
      block-size: 0.45rem;
      border-inline-end: 1px solid currentColor;
      border-block-end: 1px solid currentColor;
      rotate: 45deg;
      translate: 0 -0.1rem;
    }

    .mobile-nav[open] summary::after { rotate: 225deg; }

    .mobile-nav nav {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      padding: 0.7rem var(--gutter);
      background: var(--panel);
      border-block-end: 1px solid var(--rule);
      align-items: stretch;
      flex-direction: column;
      gap: 0;
      max-block-size: calc(100svh - var(--header-height));
      overflow: auto;
    }

    .mobile-nav nav a { padding: 0.75rem 0; }
  }

  .site-header[data-floating] {
    position: fixed;
    z-index: 10;
    inset-block-end: var(--floating-header-bottom);
    inset-inline: 0;
    inline-size: min(calc(100% - 1.5rem), 63rem);
    margin-inline: auto;
    border-radius: 999px;
    background: #1d1917;
    box-shadow: 0 0.55rem 2rem #0008;
  }

  .site-header[data-floating][data-near-footer] {
    inset-block-start: max(0.65rem, env(safe-area-inset-top, 0px));
    inset-block-end: auto;
  }

  .site-header[data-floating] .site-header-inner {
    gap: 0.65rem;
    padding-inline: 0.95rem 0.48rem;
    border: 1px solid rgb(245 240 232 / 0.26);
    border-radius: inherit;
    box-shadow: inset 0 1px 1px rgb(255 230 207 / 0.27), inset 0 -1px 2px #0008;
  }

  .site-header[data-floating] .site-header-inner::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse at 29% 0%, rgb(243 165 109 / 0.17), transparent 68%);
    pointer-events: none;
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header[data-floating] {
      background: rgb(20 16 15 / 0.49);
      -webkit-backdrop-filter: blur(15px) saturate(1.5) brightness(0.76);
      backdrop-filter: blur(15px) saturate(1.5) brightness(0.76);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header[data-floating] {
      background: #1d1917;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .site-header[data-floating] :global(.site-logo) { inline-size: 8.7rem; }
  .site-header[data-floating] .desktop-nav { gap: 0.35rem; }
  .site-header[data-floating] .desktop-nav a,
  .site-header[data-floating] .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.72rem;
    border: 1px solid rgb(245 240 232 / 0.24);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .site-header[data-floating] .desktop-nav a:hover,
  .site-header[data-floating] .mobile-nav summary:hover,
  .site-header[data-floating] .mobile-nav[open] summary { background: rgb(245 240 232 / 0.12); }
  .site-header[data-floating] .desktop-nav a[aria-current='page'] { border-color: var(--accent); }

  .site-header[data-floating] .header-actions { display: flex; gap: 0.7rem; }
  .site-header[data-floating] .sign-in { color: var(--text); white-space: nowrap; }
  .site-header[data-floating] .header-book {
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding: 0.28rem 0.32rem 0.28rem 0.85rem;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
    white-space: nowrap;
  }

  .site-header[data-floating] .header-book:hover { background: #ffc096; }
  .site-header[data-floating] .header-book-icon {
    display: grid;
    place-items: center;
    inline-size: 1.95rem;
    block-size: 1.95rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--text);
  }

  .header-book-icon .arrow { rotate: 45deg; font-size: 0.8rem; }

  .site-header[data-floating] .mobile-nav nav {
    inset-block-start: auto;
    inset-block-end: calc(100% + 0.45rem);
    max-block-size: calc(100dvh - var(--floating-header-clearance) - 0.5rem);
    padding: 0.35rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 1rem;
    background: #211c19;
    box-shadow: 0 0.55rem 2rem #0008;
  }

  .site-header[data-floating][data-near-footer] .mobile-nav nav {
    inset-block-start: calc(100% + 0.45rem);
    inset-block-end: auto;
  }

  @media (max-width: 38rem) {
    .site-header-inner { gap: 0.5rem; }
    .site-header-inner :global(.site-logo) { inline-size: 7rem; }
    .header-book { display: none; }
    .site-header[data-floating] .site-header-inner { gap: 0.35rem; padding-inline: 0.5rem; }
    .site-header[data-floating] :global(.site-logo) { inline-size: 6.25rem; }
    .site-header[data-floating] .mobile-nav summary { padding-inline: 0.5rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header[data-floating] {
      transform-origin: center bottom;
      animation: float-header-in 365ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .site-header[data-floating][data-near-footer] {
      transform-origin: center top;
      animation-name: float-header-from-top;
    }

    @keyframes float-header-in {
      from { opacity: 0.72; translate: 0 0.55rem; scale: 0.94 0.82; }
      to { opacity: 1; translate: 0 0; scale: 1; }
    }

    @keyframes float-header-from-top {
      from { opacity: 0.72; translate: 0 -0.55rem; scale: 0.94 0.82; }
      to { opacity: 1; translate: 0 0; scale: 1; }
    }
  }

  @media (forced-colors: active) {
    .site-header[data-floating] .site-header-inner {
      border-color: CanvasText;
      background: Canvas;
    }

    .site-header[data-floating] .desktop-nav a[aria-current='page'] { border-color: LinkText; }
  }
</style>
