---
import { photoFramePath, photoWorkflow } from '../photo-workflow';

const copy = [
  ['Scan VIN', 'One scan starts a photo set for the right vehicle. No retyping. No mix-ups.'],
  ['Choose a theme', 'Choose the showroom that feels like your dealership. Every photo follows the same look.'],
  ['Guided capture', 'Follow the on-screen outline, frame by frame. Your whole team gets a consistent shot list.'],
  ['Get your results', 'Your exterior shots, details and interiors come back as one finished set, ready for your website.'],
];
---
<section id="workflow" class="workflow-stage" aria-labelledby="workflow-title">
  <header class="workflow-heading">
    <h2 id="workflow-title">Four Steps.<br />One <em>Seamless Flow.</em></h2>
    <div>
      <p>One connected workflow. From the first scan to the finished set.</p>
      <a class="text-link" href="/photo-app/">Explore the Photo App <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </header>
  <div class="workflow-window">
    <ol class="workflow-track" role="list">
      {photoWorkflow.map(({ frames: [frame] }, index) => (
        <li data-workflow-card>
          <div class="workflow-frame">
            <img src={photoFramePath(frame.id)} width={frame.width} height={frame.height} alt={frame.alt} loading="lazy" decoding="async" />
          </div>
          <div class="workflow-caption">
            <span aria-hidden="true">0{index + 1}</span>
            <div><h3>{copy[index][0]}</h3><p>{copy[index][1]}</p></div>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="workflow-progress" aria-hidden="true">
    <div class="progress-track">
      <span class="progress-fill"></span><span class="progress-light"></span>
      {photoWorkflow.map(() => <span class="progress-dot"></span>)}
    </div>
    <div class="progress-copy">
      <span>Your Complete Photo Workflow</span>
      <span class="ready">Ready to publish</span>
      <span>Step <span data-workflow-step>01</span> / 04</span>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('.workflow-stage#workflow');
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');

  if (stage) {
    // The four steps remain a readable grid until the scroll animation can run.
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      void import('../home-workflow-motion').then(({ enableHomeWorkflow }) => enableHomeWorkflow(stage, motion));
    }, { rootMargin: '700px 0px' });
    observer.observe(stage);
  }
</script>

<style>
  .workflow-stage {
    --workflow-height: calc(100svh - var(--floating-header-clearance));
    min-height: var(--workflow-height);
    padding: 1.4rem var(--gutter) 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: clip;
    background: linear-gradient(var(--background), #141415 34% 66%, var(--background));
  }
  .workflow-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 0.85rem 2rem;
    width: min(100%, 83.5rem);
    margin: 0 auto 1.35rem;
  }
  .workflow-heading h2 { font: 700 clamp(2.75rem, 4.5vw, 4.25rem)/0.98 var(--display); letter-spacing: -0.025em; }
  .workflow-heading em { color: var(--accent); font-style: normal; }
  .workflow-heading p { max-width: 32ch; color: var(--muted); font-size: 0.875rem; }
  .workflow-heading a { color: var(--accent); font-size: 0.875rem; }
  .workflow-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    align-items: start;
    gap: clamp(1.4rem, 2.3vw, 2rem);
    max-width: 123.5rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .workflow-track li { min-width: 0; }
  .workflow-frame { aspect-ratio: 14 / 15; overflow: clip; border-radius: 0.65rem; background: var(--panel); }
  .workflow-frame img { width: 100%; height: 100%; object-fit: cover; }
  .workflow-caption { display: flex; align-items: start; gap: 1rem; margin-block-start: 0.9rem; }
  .workflow-caption > span { color: var(--muted); font-size: 0.75rem; font-variant-numeric: tabular-nums; margin-block-start: 0.25rem; }
  .workflow-caption h3 { font-size: clamp(1.55rem, 2.6vw, 2.375rem); font-weight: 550; letter-spacing: -0.035em; line-height: 1.1; }
  .workflow-caption p { max-width: 34ch; margin-block-start: 0.45rem; color: var(--muted); font-size: 0.85rem; }
  .workflow-progress { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .workflow-stage[data-scroll-workflow] .workflow-track { display: flex; width: max-content; max-width: none; margin: 0; }
    .workflow-stage[data-scroll-workflow] li { width: min(38vw, 29.375rem, calc(48svh * 14 / 15)); }
    .workflow-stage[data-scroll-workflow] .workflow-frame { opacity: 0.16; transition: opacity 450ms ease; }
    .workflow-stage[data-scroll-workflow] [aria-current="step"] .workflow-frame { opacity: 1; }
    .workflow-stage[data-scroll-workflow] .workflow-progress { display: block; margin-block-start: 1.15rem; }
    .progress-track { position: relative; height: 1.4rem; display: flex; justify-content: space-between; align-items: center; }
    .progress-track::before, .progress-fill { content: ''; position: absolute; width: 100%; height: 1px; background: var(--rule); }
    .progress-fill { background: var(--accent); transform: scaleX(0); transform-origin: left; }
    .progress-light { position: absolute; left: -3px; width: 7px; aspect-ratio: 1; border-radius: 50%; background: #ffcfaa; box-shadow: 0 0 15px #f3a56d99; z-index: 1; }
    .progress-dot { width: 8px; aspect-ratio: 1; border: 1px solid var(--muted); border-radius: 50%; background: var(--background); }
    .progress-dot[data-current] { background: var(--accent); border-color: var(--accent); }
    .progress-copy { display: flex; justify-content: space-between; gap: 0.6rem; margin-block-start: 0.45rem; color: var(--muted); font-size: 0.75rem; }
    .ready { color: var(--accent); opacity: 0; }
  }

  @media (max-width: 47.5rem) {
    .workflow-caption { gap: 0.7rem; }
    .workflow-caption h3 { font-size: 1.75rem; }
    .workflow-stage[data-scroll-workflow] li { width: min(78vw, calc(64svh * 14 / 15)); }
    .progress-copy > span:first-child { display: none; }
  }
</style>
