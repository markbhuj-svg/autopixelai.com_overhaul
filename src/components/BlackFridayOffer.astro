---
import SiteLogo from './SiteLogo.astro';
import { campaignUrl } from '../site';
---

<dialog id="black-friday-offer" closedby="any" aria-labelledby="black-friday-title" aria-describedby="black-friday-description">
  <div class="offer-layout">
    <img class="offer-image" src="/media/showrooms/copper-atelier.webp" width="1280" height="960" fetchpriority="low" decoding="async" alt="" />
    <div class="offer-copy">
      <SiteLogo />
      <h2 id="black-friday-title">Black Friday.<strong>2 months free.</strong></h2>
      <p id="black-friday-description">Get two months free on any monthly package, with website and listing integration included.</p>
      <a class="button offer-claim" href={`${campaignUrl}#offer-form`}>Claim the offer <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </div>
  <form class="offer-dismiss" method="dialog">
    <button type="submit" aria-label="Close Black Friday offer" autofocus><span aria-hidden="true"></span></button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#black-friday-offer')!;
  const sessionKey = 'autopixelai-black-friday-seen';

  function hasSeenOffer() {
    try { return sessionStorage.getItem(sessionKey) === '1'; }
    catch { return false; }
  }

  if (typeof dialog.showModal === 'function' && !hasSeenOffer()) {
    window.setTimeout(() => {
      if (document.hidden || hasSeenOffer() || document.querySelector('dialog[open], .mobile-nav[open]') ||
          document.activeElement?.closest('a, button, input, select, textarea, summary, [contenteditable], [tabindex]')) return;
      dialog.showModal();
      try { sessionStorage.setItem(sessionKey, '1'); } catch { /* The offer can still open if storage is unavailable. */ }
    }, 3000);
  }

  dialog.querySelector('.offer-claim')?.addEventListener('click', () => dialog.close());

  let startedOutside = false;
  dialog.addEventListener('pointerdown', (event) => { startedOutside = event.target === dialog; });
  dialog.addEventListener('click', (event) => {
    if (startedOutside && event.target === dialog && dialog.open) dialog.close();
    startedOutside = false;
  });
</script>

<style>
  dialog {
    --close-size: 2.75rem;
    --close-inset: 0.375rem;
    --close-space: calc(var(--close-size) / 2 + var(--close-inset));
    inline-size: min(64.5rem, calc(100% - 1rem));
    max-block-size: calc(100dvh - 1rem);
    padding: var(--close-space);
    border: 0;
    overflow: hidden;
    color: var(--text);
    background: transparent;
  }

  dialog:modal { overscroll-behavior: contain; }
  dialog::backdrop {
    background: #030201c9;
    backdrop-filter: blur(5px);
    overflow: hidden;
    overscroll-behavior: contain;
  }

  .offer-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    max-block-size: calc(100dvh - 1rem - 2 * var(--close-space));
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid #695041;
    border-radius: 1rem;
    background: radial-gradient(ellipse at 13% 0%, #40271c, transparent 78%), #1b1410;
  }

  .offer-copy {
    position: relative;
    grid-area: 1 / 1;
    padding: clamp(1rem, 1.8vw, 2.25rem) clamp(1.25rem, 2.5vw, 2.25rem);
    align-self: center;
  }

  .offer-copy :global(.site-logo) { inline-size: 8rem; }
  .offer-copy h2 {
    margin-block: 1rem 0.75rem;
    font: 700 clamp(2.5rem, 5.2vw, 4.1rem)/0.94 var(--display);
    letter-spacing: -0.027em;
  }

  .offer-copy strong { display: block; color: var(--accent); font-weight: inherit; }
  .offer-copy p { max-inline-size: 34ch; color: #e5cfc1; }
  .offer-claim { margin-block-start: 1.25rem; }

  .offer-image {
    grid-area: 1 / 2;
    align-self: center;
    inline-size: 100%;
    block-size: auto;
    object-fit: contain;
  }

  .offer-dismiss { position: absolute; inset-block-start: var(--close-inset); inset-inline-end: var(--close-inset); }
  .offer-dismiss button {
    display: grid;
    place-items: center;
    inline-size: var(--close-size);
    block-size: var(--close-size);
    padding: 0;
    border: 0;
    color: var(--text);
    background: transparent;
  }

  .offer-dismiss button span {
    position: relative;
    inline-size: 50%;
    block-size: 50%;
    border: 1px solid #e8c0a777;
    border-radius: 50%;
    background: #17110ff5;
  }

  .offer-dismiss button span::before, .offer-dismiss button span::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.6rem;
    block-size: 1px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .offer-dismiss button span::after { transform: translate(-50%, -50%) rotate(-45deg); }
  .offer-dismiss button:hover span { border-color: var(--accent); color: var(--accent); }
  .offer-dismiss button:focus-visible { outline: none; }
  .offer-dismiss button:focus-visible span { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 55rem) {
    dialog { inline-size: min(34rem, calc(100% - 1rem)); }
    .offer-layout { grid-template-columns: minmax(0, 1fr); }
    .offer-image { grid-area: 1 / 1; }
    .offer-copy { grid-area: 2 / 1; padding: 1.15rem clamp(1.15rem, 5vw, 2rem) 1.45rem; }
    .offer-copy h2 { margin-block: 1rem 0.65rem; font-size: clamp(3rem, 10vw, 4.5rem); }
    .offer-claim { margin-block-start: 1rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog[open] { animation: offer-enter 340ms cubic-bezier(0.16, 1, 0.3, 1) both; }
    @keyframes offer-enter {
      from { opacity: 0; translate: 0 0.8rem; scale: 0.98; }
      to { opacity: 1; translate: 0; scale: 1; }
    }
  }
</style>
