---
import { tryPhotoUrl } from '../site';

type Props = { meetingUrl?: string };
const { meetingUrl } = Astro.props;
const copy = meetingUrl ? {
  title: 'Black Friday',
  outcome: 'request received.',
  description: 'We’ve recorded your request for two free months. Our team will email you a link to book a call and go over the offer.',
  action: 'Book My Offer Call',
  href: meetingUrl,
} : {
  title: 'Inventory demo',
  outcome: 'requested.',
  description: 'We’ll email you to find a time and tailor the demo to how your team photographs and publishes inventory.',
  action: 'Try a Photo',
  href: tryPhotoUrl,
};
---
<dialog id="lead-confirmation" class="lead-confirmation" closedby="any" aria-labelledby="lead-confirmation-title" aria-describedby="lead-confirmation-detail">
  <form class="confirmation-dismiss" method="dialog">
    <button type="submit" aria-label="Close confirmation" autofocus></button>
  </form>
  <div class="confirmation-check" aria-hidden="true"></div>
  <h2 id="lead-confirmation-title">{copy.title} <strong>{copy.outcome}</strong></h2>
  <p id="lead-confirmation-detail">{copy.description}</p>
  <p class="confirmation-reference">Reference <span data-lead-reference></span></p>
  <a class="button" href={copy.href}>{copy.action} <span class="arrow" aria-hidden="true"></span></a>
  <div class="confirmation-contact">
    <p>Questions before we connect?</p>
    <address>
      <a class="text-link" href="mailto:team@autopixelai.com">team@autopixelai.com</a>
      <a class="text-link" href="tel:+14372373275">+1 (437) 237-3275</a>
    </address>
  </div>
</dialog>

<style>
  .lead-confirmation {
    inline-size: min(37rem, calc(100% - 2rem));
    max-block-size: calc(100dvh - 2rem);
    padding: clamp(1.35rem, 4vw, 2.75rem);
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid #654d3e;
    border-radius: 0.95rem;
    background: radial-gradient(ellipse at top left, #382218, transparent 80%), #181210;
    color: var(--text);
  }

  .lead-confirmation::backdrop { background: #030201dc; overflow: hidden; overscroll-behavior: contain; }
  .confirmation-dismiss { position: absolute; inset-block-start: 1rem; inset-inline-end: 1rem; }
  .confirmation-dismiss button {
    position: relative;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid #654d3e;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
  }
  .confirmation-dismiss button:hover { color: var(--accent); border-color: var(--accent); }
  .confirmation-dismiss button::before, .confirmation-dismiss button::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.9rem;
    block-size: 1px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .confirmation-dismiss button::after { transform: translate(-50%, -50%) rotate(-45deg); }

  .confirmation-check {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid #8a5c42;
    border-radius: 50%;
    color: var(--accent);
  }
  .confirmation-check::before {
    content: '';
    inline-size: 0.56rem;
    block-size: 1rem;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: translateY(-0.08rem) rotate(45deg);
  }
  #lead-confirmation-title {
    margin-block: 1rem 0.8rem;
    font: 700 clamp(2.8rem, 2rem + 3vw, 4.4rem)/0.93 var(--display);
    letter-spacing: -0.028em;
  }
  #lead-confirmation-title strong { display: block; color: var(--accent); font-weight: inherit; }
  #lead-confirmation-detail { max-inline-size: 43ch; color: var(--muted); }
  .confirmation-reference { margin-block: 0.85rem 1.35rem; color: var(--muted); font-size: 0.82rem; }
  .confirmation-reference span { margin-inline-start: 0.35rem; color: var(--text); font-weight: 700; }
  .confirmation-contact { margin-block-start: 1.45rem; padding-block-start: 1.05rem; border-block-start: 1px solid #50372b; }
  .confirmation-contact p { color: var(--muted); font-size: 0.875rem; }
  .confirmation-contact address {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    margin-block-start: 0.35rem;
    font-size: 0.875rem;
    font-style: normal;
  }
</style>
