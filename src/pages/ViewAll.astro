---
import SiteLayout from '../layouts/SiteLayout.astro';
import pairs from '../data/client-comparison.json';
import '../styles/product.css';
---
<SiteLayout title="Vehicle Photo Comparison" description="See the original vehicle photos alongside the complete AutoPixelAI photo set." path="/ViewAll" noindex>
  <section class="product-section">
    <div class="wrap">
      <h1>Vehicle photo comparison.</h1>
      <p class="product-lead">See the original photos alongside the AutoPixelAI results.</p>
      <ol class="photo-pairs" aria-label="Vehicle photo pairs" role="list">
        {pairs.map(({ id, before, after }, index) => (
          <li class="photo-pair" style={`--frame-ratio:${after.width}/${after.height}`}>
            {[{ side: 'before', label: 'Before', ...before }, { side: 'after', label: 'AutoPixelAI', ...after }].map(({ side, label, width, height, alt }) => (
              <figure>
                <figcaption>{label}</figcaption>
                <img src={`/assets/client-comparison/${side}-${id}.webp`} width={width} height={height} alt={alt}
                  fetchpriority={index === 0 && side === 'after' ? 'high' : undefined}
                  loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </figure>
            ))}
          </li>
        ))}
      </ol>
    </div>
  </section>
</SiteLayout>

<style>
  h1 { font: 700 clamp(2.8rem, 5vw, 5rem)/0.98 var(--display); letter-spacing: -0.025em; }
  .photo-pairs { margin: 2rem 0 0; padding: 0; list-style: none; }
  .photo-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding-block: 1.2rem 2rem; border-block-start: 1px solid var(--rule); }
  figure { margin: 0; min-inline-size: 0; }
  figcaption { padding-block-end: 0.6rem; font-size: 0.9rem; font-weight: 700; }
  figure + figure figcaption { color: var(--accent); }
  .photo-pair img { inline-size: 100%; block-size: auto; aspect-ratio: var(--frame-ratio); object-fit: contain; border-radius: 0.55rem; background: var(--panel); }
  @media (max-width: 42rem) { .photo-pair { grid-template-columns: minmax(0, 1fr); } }
</style>
