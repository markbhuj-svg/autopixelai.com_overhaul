---
import { brandMark } from '../brand-mark';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import BlackFridayOffer from '../components/BlackFridayOffer.astro';
import ShowroomVisualizer from '../components/ShowroomVisualizer.astro';
import VehiclePhotoUpload from '../components/VehiclePhotoUpload.astro';
import HomeWorkflow from '../components/HomeWorkflow.astro';
import HomeShowrooms from '../components/HomeShowrooms.astro';
import { bookingUrl, integrationPartners } from '../site';

// Natural Resources Canada's 2026 ratings, plus the makes shown in the photo comparison.
const vehicleMakes = [
  'Acura', 'Alfa Romeo', 'Aston Martin', 'Audi', 'Bentley', 'BMW', 'Buick', 'Cadillac', 'Chevrolet',
  'Chrysler', 'CUPRA', 'Dodge', 'Ferrari', 'FIAT', 'Ford', 'Genesis', 'GMC', 'Honda', 'Hyundai', 'INEOS',
  'Infiniti', 'Jaguar', 'Jeep', 'Kia', 'Lamborghini', 'Land Rover', 'Lexus', 'Lincoln', 'Lotus',
  'Mazda', 'Mercedes-Benz', 'MINI', 'Mitsubishi', 'Nissan', 'Polestar', 'Porsche', 'Ram', 'Rivian',
  'Rolls-Royce', 'SEAT', 'Subaru', 'Tesla', 'Toyota', 'VinFast', 'Volkswagen', 'Volvo',
];
const brandRows = [
  { label: 'Integration partners', names: integrationPartners, copies: 5 },
  { label: 'Vehicle makes', names: vehicleMakes, copies: 2 },
].map(({ label, names, copies }) => ({
  label,
  copies,
  marks: names.map((name) => ({ name, image: brandMark(name) })),
}));

---
<SiteLayout
  title="AI Car Photography for Dealerships"
  description="Guide vehicle capture, apply a consistent showroom look, and connect finished photos to your inventory workflow."
  path="/"
>
      <div class="home-intro">
        <HomeHero />

        <div class="brand-strip">
          {brandRows.map(({ label, marks, copies }) => (
            <div class="brand-rail" role="region" aria-label={label} tabindex="0" style={{ '--loop-shift': `${-100 / copies}%` }}>
              <div class="brand-track">
                {Array.from({ length: copies }, (_, index) => (
                  <ul class:list={{ 'brand-repeat': index > 0 }} role="list" aria-hidden={index > 0 ? 'true' : undefined}>
                    {marks.map(({ name, image }) => (
                      <li>
                        {image ? <img src={image.src} alt={name} width={image.width} height={image.height} decoding="async" fetchpriority="low" /> : name}
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <section id="visualizer" class="chapter showroom-visualizer" aria-labelledby="visualizer-title">
        <div class="wrap">
          <div class="section-heading">
            <div>
              <h2 id="visualizer-title">Showroom Visualizer.</h2>
              <p>Choose a vehicle, background, and angle to see how your listings could look.</p>
            </div>
            <a class="button" href="#image-demo">Try it on your own inventory <span class="arrow scroll-arrow" aria-hidden="true"></span></a>
          </div>
          <ShowroomVisualizer />
        </div>
      </section>

      <section class="chapter inventory-preview" aria-labelledby="inventory-preview-title">
        <div class="wrap">
          <div>
            <h2 id="inventory-preview-title">Try it on your own inventory.</h2>
            <p>Choose a clear photo with the whole vehicle in frame to see it with a showroom background.</p>
          </div>
          <VehiclePhotoUpload />
        </div>
      </section>

      <HomeWorkflow />
      <HomeShowrooms />

      <section class="book-section" aria-labelledby="book-title">
        <div class="wrap book-inner">
          <div>
            <h2 id="book-title">See it with your inventory.</h2>
            <p>Bring a vehicle photo and we’ll walk through the look and workflow for your store.</p>
          </div>
          <a class="button" href={bookingUrl}>Book a demo <span class="arrow" aria-hidden="true"></span></a>
        </div>
      </section>
  <BlackFridayOffer />
</SiteLayout>

<style>
  h2 {
    font-family: var(--display);
    font-weight: 700;
    line-height: 0.91;
    letter-spacing: -0.018em;
  }

  .chapter {
    padding-block: clamp(3.75rem, 7.5vw, 7.5rem);
  }

  .home-intro {
    display: grid;
    grid-template: 1fr auto / minmax(0, 1fr);
    min-block-size: calc(100dvh - var(--header-height));
  }

  .brand-strip {
    --brand-gap: clamp(2rem, 3.2vw, 4rem);
    --mark-height: clamp(1.35rem, 1.8vw, 1.85rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
    padding-block: 0.35rem 0.7rem;
  }

  .brand-rail {
    --edge: clamp(2.5rem, 10vw, 12rem);
    --edge-fade: linear-gradient(90deg, transparent, #0006 calc(var(--edge) / 2), black var(--edge), black calc(100% - var(--edge)), #0006 calc(100% - var(--edge) / 2), transparent);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: var(--edge-fade);
    mask-image: var(--edge-fade);
  }

  .brand-rail::-webkit-scrollbar { display: none; }

  .brand-rail:focus-visible {
    -webkit-mask-image: none;
    mask-image: none;
    outline-offset: -2px;
  }

  .brand-track {
    display: flex;
    inline-size: max-content;
  }

  .brand-rail ul {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--brand-gap);
    margin: 0;
    padding: 0.35rem var(--edge);
    list-style: none;
    white-space: nowrap;
    color: #e2e2e2;
  }

  .brand-rail img {
    block-size: var(--mark-height);
    inline-size: auto;
    max-inline-size: clamp(7rem, 13vw, 12rem);
    object-fit: contain;
    opacity: 0.9;
  }

  .brand-rail .brand-repeat { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .brand-rail:first-child {
      --loop-duration: 38s;
      --loop-direction: reverse;
    }

    :global(body[data-home-motion]) .brand-rail:not(:focus) { overflow-x: clip; }
    :global(body[data-home-motion]) .brand-rail:not(:focus) ul { padding-inline: calc(var(--brand-gap) / 2); }
    :global(body[data-home-motion]) .brand-rail:not(:focus) .brand-repeat { display: flex; }

    :global(body[data-home-motion]) .brand-rail:not(:focus) .brand-track {
      animation: brand-scroll var(--loop-duration, 150s) linear infinite var(--loop-direction, normal);
    }

    @keyframes brand-scroll {
      to { transform: translateX(var(--loop-shift)); }
    }
  }

  .showroom-visualizer .wrap, .inventory-preview .wrap { max-inline-size: 88rem; }
  .showroom-visualizer .section-heading { margin-block-end: clamp(1.5rem, 3vw, 2.5rem); }
  .scroll-arrow { rotate: 135deg; }

  .inventory-preview {
    padding-block-start: 0;
    background: linear-gradient(var(--background), #141415 65%, var(--background));
  }

  .inventory-preview .wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(1.75rem, 5vw, 5rem);
  }

  .inventory-preview p { margin-block-start: 1.15rem; max-inline-size: 42ch; color: var(--muted); }

  h2 { font-size: clamp(3.25rem, 1.8rem + 3.5vw, 5.8rem); }

  .section-heading p, .book-inner p {
    color: var(--muted);
    margin-block: 1.15rem;
    max-inline-size: 46ch;
  }

  .section-heading, .book-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .section-heading p, .book-inner p { margin-block-end: 0; }

  .book-section {
    padding-block: clamp(3.25rem, 6vw, 5rem);
    background: linear-gradient(var(--background), #201b19 46%, var(--background));
  }

  .book-inner { align-items: center; }
  .book-inner h2 { font-size: clamp(2.75rem, 1.7rem + 3.3vw, 4.8rem); }

  @media (max-width: 52rem) {
    .inventory-preview .wrap { grid-template-columns: minmax(0, 1fr); }
  }

</style>
