---
import DialogCornerClose from '../components/DialogCornerClose.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { bookingUrl } from '../site';
import catalog from '../data/client-showrooms.json';
import '../styles/product.css';

const customUrl = bookingUrl + '?request=custom-background';
const themes = catalog.slides.slice(0, 120);
---
<SiteLayout
  title="Virtual Car Showrooms"
  description="Explore real AutoPixelAI background samples and find a consistent setting for your dealership inventory."
  path="/virtual-showrooms/"
>
  <section class="showroom-hero product-hero">
    <div class="wrap product-split">
      <div>
        <h1>Set the scene for your inventory.</h1>
        <p class="product-lead">Explore the same vehicle in a range of showroom settings, from clean studios to open-air backdrops.</p>
        <div class="product-actions">
          <a class="button" href="#showroom-grid">Explore the gallery</a>
          <a class="text-link" href={customUrl}>Discuss a custom background</a>
        </div>
      </div>
      <img class="hero-sample" src="/media/showrooms/daylight-gallery.webp" width="1280" height="960" fetchpriority="high" alt="A black sedan in a bright architectural showroom" />
    </div>
  </section>

  <section id="showroom-grid" class="product-section" aria-labelledby="gallery-heading">
    <div class="wrap">
      <h2 id="gallery-heading" class="gallery-heading">Find a setting.</h2>
      <p class="gallery-intro">These are just {themes.length} examples from our library of 400+ showroom themes. We can also create a custom background to match your dealership.</p>
      <a class="button gallery-cta" href={customUrl}>Request a custom background <span class="arrow" aria-hidden="true"></span></a>
      <ul class="gallery" role="list">
        {themes.map(({ label, image, thumbnail, thumbnailWidth, thumbnailHeight }) => (
          <li>
            <a href={image} data-title={label} aria-label={`Preview ${label}`}>
              <img src={thumbnail} width={thumbnailWidth} height={thumbnailHeight} loading="lazy" decoding="async" alt="" />
              <div class="gallery-caption">
                <h3>{label}</h3>
                <span class="arrow" aria-hidden="true"></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog id="showroom-preview" aria-labelledby="preview-title" closedby="any">
    <div class="preview-panel">
      <img src={themes[0].thumbnail} width={themes[0].width} height={themes[0].height} loading="lazy" alt="" />
      <div class="preview-caption">
        <h2 id="preview-title">{themes[0].label}</h2>
        <a class="button" href={customUrl + '#demo-form'}>Book a demo <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
    <DialogCornerClose label="Close showroom preview" />
  </dialog>
</SiteLayout>

<script>
  const preview = document.querySelector<HTMLDialogElement>('#showroom-preview');
  const previewTitle = preview?.querySelector('h2');
  const previewImage = preview?.querySelector('img');

  if (preview && typeof preview.showModal === 'function' && previewTitle && previewImage) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.gallery a')) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        previewTitle.textContent = link.dataset.title ?? '';
        previewImage.src = link.href;
        preview.showModal();
      });
    }

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      let pressedBackdrop = false;
      preview.addEventListener('pointerdown', (event) => { pressedBackdrop = event.target === preview; });
      preview.addEventListener('click', (event) => {
        if (pressedBackdrop && event.target === preview) preview.close();
        pressedBackdrop = false;
      });
    }
  }
</script>

<style>
  .showroom-hero { background: linear-gradient(var(--background), #101011 42%, var(--background)); }

  .hero-sample { width: 100%; height: auto; border: 1px solid var(--rule); }
  #showroom-grid { scroll-margin-block-start: 1rem; }
  .gallery-intro { max-inline-size: 52ch; color: var(--muted); margin-block-start: 1rem; }
  .gallery-cta { margin-block: 1.25rem clamp(1.75rem, 4vw, 3rem); }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.35rem);
  }

  .gallery a {
    display: block;
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .gallery a:hover { border-color: var(--accent); }
  .gallery img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }

  .gallery-caption {
    padding: 0.85rem 0.95rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .gallery-caption h3 { font-size: 1rem; font-weight: 650; }

  dialog {
    --close-size: 2.75rem;
    --close-inset: 0.375rem;
    --close-space: calc(var(--close-size) / 2 + var(--close-inset));
    --max-image-height: calc(100dvh - 1rem - 2 * var(--close-space));
    inline-size: min(62rem, calc(100% - 1rem), calc(var(--max-image-height) * 4 / 3 + 2 * var(--close-space)));
    max-inline-size: none;
    max-block-size: calc(100dvh - 1rem);
    padding: var(--close-space);
    border: 0;
    overflow: hidden;
    color: var(--text);
    background: transparent;
  }

  dialog:modal { overscroll-behavior: contain; }
  dialog::backdrop { background: #000d; overflow: hidden; overscroll-behavior: contain; }

  .preview-panel { position: relative; overflow: hidden; border-radius: 1rem; background: var(--panel); }
  .preview-panel img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }

  .preview-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.55rem;
    padding: clamp(0.7rem, 2.25vw, 1.45rem);
    padding-block-start: clamp(1.25rem, 4vw, 3rem);
    background: linear-gradient(transparent, #090706cf 48%, #090706f5);
  }

  .preview-caption h2 { font-size: clamp(1.15rem, 0.9rem + 1vw, 1.65rem); }
  .preview-caption .button { gap: 0.55rem; padding-inline: clamp(0.7rem, 2vw, 1.2rem); }

  @media (max-width: 55rem) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 24rem) {
    .gallery-caption { padding: 0.6rem; }
    .gallery-caption h3 { font-size: 0.875rem; }
    .gallery-caption .arrow { display: none; }
  }
</style>
