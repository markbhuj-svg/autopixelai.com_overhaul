---
import SiteLayout from '../layouts/SiteLayout.astro';
import { bookingUrl } from '../site';
import '../styles/product.css';

const customUrl = bookingUrl + '?request=custom-background';
const categories = ['Clean studios', 'Architectural', 'Industrial', 'Outdoor', 'Dealerships'];
const themes = [
  ['daylight-gallery', 'Daylight gallery', 'Architectural'],
  ['graphite-sweep', 'Graphite sweep', 'Clean studios'],
  ['alpine-overlook', 'Alpine overlook', 'Outdoor'],
  ['copper-atelier', 'Copper atelier', 'Architectural'],
  ['raw-concrete', 'Raw concrete', 'Industrial'],
  ['city-dealership', 'City dealership', 'Dealerships'],
  ['infinity-white', 'Infinity white', 'Clean studios'],
  ['timber-rotunda', 'Timber rotunda', 'Architectural'],
  ['factory-skylight', 'Factory skylight', 'Industrial'],
  ['golden-hour', 'Golden hour', 'Outdoor'],
  ['service-centre', 'Service centre', 'Dealerships'],
  ['softbox-studio', 'Softbox studio', 'Clean studios'],
];
---
<SiteLayout
  title="Virtual Car Showrooms"
  description="Explore real AutoPixelAI background samples and find a consistent setting for your dealership inventory."
  path="/virtual-showrooms/"
>
  <section class="showroom-hero product-hero">
    <div class="wrap product-split">
      <div>
        <h1>Set the scene for your inventory.</h1>
        <p class="product-lead">Explore the same vehicle in a range of showroom settings, from clean studios to open-air backdrops.</p>
        <div class="product-actions">
          <a class="button" href="#showroom-grid">Explore the gallery</a>
          <a class="text-link" href={customUrl}>Discuss a custom background</a>
        </div>
      </div>
      <img class="hero-sample" src="/media/showrooms/daylight-gallery.webp" width="1280" height="960" fetchpriority="high" alt="A black sedan in the Daylight gallery showroom" />
    </div>
  </section>

  <section id="showroom-grid" class="product-section" aria-labelledby="gallery-heading">
    <div class="wrap">
      <h2 id="gallery-heading" class="gallery-heading">Find a setting.</h2>
      <p class="visually-hidden" data-gallery-status role="status"></p>
      <search class="gallery-filters" aria-label="Filter showroom settings" hidden>
        <button type="button" value="" aria-pressed="true">All settings</button>
        {categories.map((category) => <button type="button" value={category} aria-pressed="false">{category}</button>)}
      </search>
      <ul class="gallery">
        {themes.map(([slug, title, category]) => (
          <li data-category={category}>
            <a href={`/media/showrooms/${slug}.webp`} data-title={title}>
              <img src={`/media/${slug}.webp`} width="480" height="360" loading="lazy" alt={`Black sedan in the ${title} setting`} />
              <div class="gallery-caption">
                <h3>{title}</h3>
                <span class="arrow" aria-hidden="true"></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="product-callout">
    <div class="wrap">
      <div><h2>A setting built around your brand.</h2><p>Share a reference, your dealership colors, and a sample vehicle photo to discuss a custom look.</p></div>
      <a class="button" href={customUrl}>Discuss a custom background</a>
    </div>
  </section>

  <dialog id="showroom-preview" aria-labelledby="preview-title" closedby="any">
    <div class="preview-header">
      <h2 id="preview-title">Daylight gallery</h2>
      <form method="dialog">
        <button class="button button-outline" aria-label="Close showroom preview" autofocus>Close</button>
      </form>
    </div>
    <img src="/media/showrooms/daylight-gallery.webp" width="1280" height="960" loading="lazy" alt="Black sedan in the Daylight gallery setting" />
  </dialog>
</SiteLayout>

<script>
  const filters = document.querySelector<HTMLElement>('.gallery-filters');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.gallery-filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.gallery li')];
  const count = document.querySelector<HTMLElement>('[data-gallery-status]');
  const values = new Set(buttons.map((button) => button.value));

  function applyFilter() {
    const requested = new URLSearchParams(window.location.search).get('category') ?? '';
    const category = values.has(requested) ? requested : '';
    let visible = 0;
    for (const card of cards) {
      card.hidden = category !== '' && card.dataset.category !== category;
      if (!card.hidden) visible++;
    }
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.value === category));
    if (count) count.textContent = `${visible} ${visible === 1 ? 'setting' : 'settings'}`;
  }

  if (filters) {
    applyFilter();
    filters.hidden = false;
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const url = new URL(window.location.href);
        if (button.value) url.searchParams.set('category', button.value);
        else url.searchParams.delete('category');
        if (url.href !== window.location.href) history.pushState(null, '', url);
        applyFilter();
      });
    }
    window.addEventListener('popstate', applyFilter);
  }

  const preview = document.querySelector<HTMLDialogElement>('#showroom-preview');
  const previewTitle = preview?.querySelector('h2');
  const previewImage = preview?.querySelector('img');

  if (preview && typeof preview.showModal === 'function' && previewTitle && previewImage) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.gallery a')) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        previewTitle.textContent = link.dataset.title ?? '';
        previewImage.src = link.href;
        previewImage.alt = link.querySelector('img')?.alt ?? '';
        preview.showModal();
      });
    }
  }
</script>

<style>
  .showroom-hero { background: linear-gradient(var(--background), #101011 42%, var(--background)); }

  .hero-sample { width: 100%; height: auto; border: 1px solid var(--rule); }
  .gallery-heading { margin-block-end: 1.35rem; }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-block-end: 1.75rem;
  }

  .gallery-filters button {
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.95rem;
    font-size: 0.875rem;
  }

  .gallery-filters button:hover { color: var(--text); border-color: var(--text); }
  .gallery-filters button[aria-pressed="true"] { color: var(--ink); background: var(--accent); border-color: var(--accent); }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.35rem);
  }

  .gallery a {
    display: block;
    border: 1px solid var(--rule);
    background: var(--panel);
  }

  .gallery a:hover { border-color: var(--accent); }
  .gallery img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }

  .gallery-caption {
    padding: 0.85rem 0.95rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .gallery-caption h3 { font-size: 1rem; font-weight: 650; }

  dialog {
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--rule);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    width: min(62rem, calc(100% - 1.5rem));
    max-block-size: calc(100svh - 2rem);
  }

  dialog:modal { overscroll-behavior: contain; }
  dialog::backdrop { background: #000d; overflow: hidden; overscroll-behavior: contain; }

  .preview-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-block-end: 0.75rem;
  }

  .preview-header h2 { font-size: clamp(1.15rem, 0.9rem + 1vw, 1.65rem); }

  dialog img {
    width: 100%;
    height: auto;
    max-block-size: 73svh;
    object-fit: contain;
    background: #080809;
  }

  @media (max-width: 55rem) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 24rem) {
    .gallery-caption { padding: 0.6rem; }
    .gallery-caption h3 { font-size: 0.875rem; }
    .gallery-caption .arrow { display: none; }
  }
</style>
