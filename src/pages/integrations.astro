---
import SiteLayout from '../layouts/SiteLayout.astro';
import { brandMark } from '../brand-mark';
import { bookingUrl, integrationPartners } from '../site';
import '../styles/product.css';

const providerDemo = bookingUrl + '?request=integration';
const partnerDemo = bookingUrl + '?request=partnership';
const partners = integrationPartners.map((name) => ({ name, image: brandMark(name) }));

const systems = [
  ['Inventory management systems', 'Match the finished photo set to the right vehicle record using the VIN or stock number in your IMS.'],
  ['Dealership website providers', 'Deliver listing-ready photos to your website provider in the format and shot order your listings expect.'],
  ['Marketplaces and listing feeds', 'Send the same photo set to the sales channels your team uses through the agreed inventory feed.'],
];

const handoff = [
  ['Map your setup', 'Tell us which system holds your inventory and where the finished photos need to go.'],
  ['Connect the feed', 'Agree on the vehicle identifier, image format, publishing permissions, and delivery schedule.'],
  ['Verify a listing', 'Test with one vehicle and check that its photos reach the right record in the intended order.'],
];
---
<SiteLayout
  title="Integrations & Partnerships"
  description="Connect AutoPixelAI directly to your inventory management system, dealership website provider, and listing feeds. Explore integrations and ways to partner."
  path="/integrations/"
>
  <section class="product-hero">
    <div class="wrap product-split integration-intro">
      <div>
        <h1>Finished photos.<br /><em>Connected inventory.</em></h1>
        <p class="product-lead">Connect AutoPixelAI directly to your inventory management system, dealership website provider, and listing feeds. Finished photos reach the systems your team already uses.</p>
        <div class="product-actions">
          <a class="button" href={providerDemo}>Discuss your integration <span class="arrow" aria-hidden="true"></span></a>
          <a class="text-link" href="#partners">See integration partners ↓</a>
        </div>
      </div>
      <img class="integration-image" src="/media/showrooms/factory-skylight.webp" width="1280" height="960" alt="A finished inventory photo of a black sedan in an industrial showroom" fetchpriority="high" />
    </div>
  </section>

  <section id="partners" class="product-section partner-section" aria-label="Integration partners">
    <div class="wrap">
      <p class="partner-intro">We can work with any inventory management system, dealership website provider, or listing platform to set up direct photo delivery.</p>
      <ul class="partner-logos" role="list">
        {partners.map(({ name, image }) => (
          <li>
            {image ? <img src={image.src} width={image.width} height={image.height} alt={name} loading="lazy" /> : name}
          </li>
        ))}
        <li class="other-provider">
          <a href={providerDemo}>
            <strong>Other provider</strong>
            <span class="text-link">Discuss your setup <span class="arrow" aria-hidden="true"></span></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="product-section" aria-labelledby="systems-heading">
    <div class="wrap product-split systems-layout">
      <div>
        <h2 id="systems-heading">Connect the systems that run your inventory.</h2>
        <p class="product-lead">Set up direct delivery around the providers and feeds you already use.</p>
      </div>
      <dl class="system-list">
        {systems.map(([title, description]) => (
          <div><dt>{title}</dt><dd>{description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="product-section handoff" aria-labelledby="handoff-heading">
    <div class="wrap">
      <h2 id="handoff-heading">From setup to the first live listing.</h2>
      <ol class="handoff-steps">
        {handoff.map(([title, description]) => (
          <li><h3>{title}</h3><p>{description}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="product-section" aria-labelledby="questions-heading">
    <div class="wrap product-split systems-layout">
      <h2 id="questions-heading">Questions about your setup.</h2>
      <div class="questions">
        <details>
          <summary>Can you connect to my provider?</summary>
          <p>Share the name of your IMS, website provider, or marketplace. We can work directly with your provider to confirm the feed format, access, and image delivery.</p>
        </details>
        <details>
          <summary>What if we use a custom inventory feed?</summary>
          <p>Bring a sample feed or its specification. We’ll map how to identify the vehicle, where to send the photos, and how updates reach your listings.</p>
        </details>
        <details>
          <summary>Can individual stores use different setups?</summary>
          <p>Share each store’s website, feeds, and branding requirements. We’ll identify what can be shared across the group and what needs its own setup.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="product-callout" aria-labelledby="partnership-heading">
    <div class="wrap">
      <div>
        <h2 id="partnership-heading">Bring AutoPixelAI to your network.</h2>
        <p>For dealership groups, software providers, marketplaces, and agencies, tell us who you serve and where vehicle photography fits in your workflow.</p>
      </div>
      <a class="button" href={partnerDemo}>Discuss a partnership <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .integration-intro em { color: var(--accent); font-style: normal; }
  .integration-intro .text-link { color: var(--accent); }
  .integration-image { width: 100%; height: auto; border-radius: 0.65rem; }

  .partner-section {
    background: linear-gradient(var(--background), #111011 35% 65%, var(--background));
  }

  .partner-intro {
    max-inline-size: 60ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.45rem);
  }

  .partner-logos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.65rem, 1.5vw, 1.25rem);
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .partner-logos li {
    display: grid;
    place-items: center;
    min-block-size: clamp(5.25rem, 12vw, 11rem);
    padding: clamp(0.8rem, 2.3vw, 2rem);
    border: 1px solid #2b2727;
    border-radius: 0.65rem;
    background: #171516;
  }

  .partner-logos img {
    width: auto;
    height: auto;
    max-inline-size: min(88%, 15.5rem);
    max-block-size: clamp(1.5rem, 4vw, 2.85rem);
    opacity: 0.9;
  }

  .partner-logos .other-provider {
    grid-column: 1 / -1;
    place-items: stretch;
    min-block-size: 4.5rem;
    padding: 0;
  }

  .other-provider a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem clamp(1rem, 2.3vw, 2rem);
    border-radius: inherit;
  }

  .other-provider a:hover { background: #231b18; }
  .other-provider .text-link { color: var(--accent); font-size: 0.875rem; }

  .systems-layout { align-items: start; }
  .system-list { margin: 0; }
  .system-list > div { padding-block: 1rem; border-block-start: 1px solid var(--rule); }
  .system-list dt { font-size: 1.12rem; font-weight: 700; }
  .system-list dd { margin: 0.45rem 0 0; color: var(--muted); max-inline-size: 53ch; }

  .handoff { background: linear-gradient(var(--background), #171311 50%, var(--background)); }
  .handoff-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 4vw, 3.5rem);
    margin-block: 1.8rem 0;
    padding-inline-start: 1.45rem;
  }

  .handoff-steps li::marker { color: var(--accent); font-weight: 700; }
  .handoff-steps h3 { margin-block: 0 0.55rem; font: 700 1.8rem/1 var(--display); }
  .handoff-steps p { color: var(--muted); max-inline-size: 34ch; }

  .questions details { border-block-start: 1px solid var(--rule); }
  .questions details:last-child { border-block-end: 1px solid var(--rule); }
  .questions summary { padding: 0.9rem 0; cursor: pointer; font-weight: 650; }
  .questions details p { max-inline-size: 54ch; padding: 0 0 1rem 1.1rem; color: var(--muted); }

  @media (max-width: 42rem) {
    .partner-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .partner-logos .other-provider { grid-column: auto; min-block-size: 5.25rem; }
    .other-provider a { flex-direction: column; justify-content: center; gap: 0.15rem; padding: 0.55rem; text-align: center; }
    .other-provider .text-link { min-block-size: 0; font-size: 0.78rem; }
    .handoff-steps { grid-template-columns: minmax(0, 1fr); }
  }
</style>
